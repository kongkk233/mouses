# Keep the default loopback binding when using a local reverse proxy.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# HTTPS origin of the app, required when subscribing from a phone.
APP_ORIGIN=http://localhost:3001
# Enable after HTTPS reverse proxy is configured.
TRUST_PROXY=0
# Kill switch: business records and in-app reminders continue working.
PUSH_ENABLED=1
# Optional contact address for the push service.
VAPID_SUBJECT=mailto:admin@example.com
