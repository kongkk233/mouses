# Keep the default loopback binding when using a local reverse proxy.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# HTTPS origin of the app, required when subscribing from a phone.
APP_ORIGIN=http://localhost:3001
# Enable after HTTPS reverse proxy is configured.
TRUST_PROXY=0
# Kill switch: business records and in-app reminders continue working.
PUSH_ENABLED=1
# Optional contact address for the push service.
VAPID_SUBJECT=mailto:admin@example.com
# Distinct administrator password; existing APP_PASSWORD remains member access.
# ADMIN_PASSWORD=
# APP_ENV=production
# STAGING_ORIGIN=https://mouses-test.example.com
# PRODUCTION_ORIGIN=https://mouses.example.com
# Provision keys with the deployment setup script, never commit them.
# STAGING_SIGNING_KEY=
# STAGING_VERIFY_KEY=
# ENV_STATUS_TOKEN=
# STAGING_STATUS_URL=http://127.0.0.1:18327/internal/status
