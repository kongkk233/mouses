[Unit]
Description=Consistent SQLite backup for Mouse Nook

[Service]
Type=oneshot
User=mouse-nook
Group=mouse-nook
WorkingDirectory=/srv/mouse-nook/current
EnvironmentFile=/etc/mouse-nook.env
ExecStart=/usr/bin/node dist-server/scripts/backup.js
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mouse-nook
